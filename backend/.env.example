PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOW_VERCEL_PREVIEWS=false
APPONO_TRUST_PROXY=false
FRONTEND_PUBLIC_URL=https://seu-frontend.vercel.app
BACKEND_PUBLIC_URL=https://seu-backend.vercel.app
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-chave-publica
SUPABASE_SECRET_KEY=sua-chave-secreta-do-backend
# Mantenha false. O inicializador carrega as CAs do sistema, inclusive no Node antigo do Windows.
SUPABASE_ALLOW_INSECURE_TLS=false
# Consulta CPF v3 do Serpro. Sem credenciais, apenas o formato é validado.
SERPRO_CPF_CONSUMER_KEY=
SERPRO_CPF_CONSUMER_SECRET=
SERPRO_CPF_API_URL=https://gateway.apiserpro.serpro.gov.br/consulta-cpf-df/v3
SERPRO_CPF_TOKEN_URL=https://gateway.apiserpro.serpro.gov.br/token
SERPRO_CPF_TIMEOUT_MS=5000
MERCADO_PAGO_TEST_ACCESS_TOKEN=APP_USR-ou-TEST-seu-access-token-de-teste
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-seu-access-token-de-producao
MERCADO_PAGO_APP_ID=seu-app-id-oauth
MERCADO_PAGO_CLIENT_SECRET=seu-client-secret-oauth
MERCADO_PAGO_REDIRECT_URI=https://seu-backend.vercel.app/api/marketplace/mercado-pago/callback
MERCADO_PAGO_WEBHOOK_SECRET=seu-secret-do-webhook
# Mantenha true fora do ambiente local para rejeitar webhooks sem assinatura.
MERCADO_PAGO_WEBHOOK_SIGNATURE_REQUIRED=true
APPONO_MERCADO_PAGO_TOKEN_ENCRYPTION_KEY=base64-de-32-bytes-exclusiva-para-mercado-pago
MERCADO_PAGO_MARKETPLACE_FEE_PERCENTUAL=13
MERCADO_PAGO_MODO_REPASSE=SIMULADO
MERCADO_PAGO_PERMITIR_PRODUCAO=false
APPONO_ADMIN_EMAILS=admin@appono.com.br
APPONO_CALENDAR_TOKEN_ENCRYPTION_KEY=base64-de-32-bytes
APPONO_ROTINA_AGENDA_GOOGLE_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=seu-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=seu-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/api/rotina/agenda/google/callback
APPONO_ROTINA_AGENDA_OUTLOOK_ENABLED=false
MICROSOFT_CALENDAR_CLIENT_ID=seu-client-id
MICROSOFT_CALENDAR_CLIENT_SECRET=seu-client-secret
MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:3001/api/rotina/agenda/outlook/callback
APPONO_EMAIL_ENABLED=false
APPONO_ROTINA_GROUPS_ENABLED=false
APPONO_ROTINA_INSIGHTS_ENABLED=false
APPONO_ROTINA_SHADOW_ENABLED=false
# V2.1 titular para a demonstracao. O kill switch restaura o controle deterministico.
APPONO_ROTINA_V2_1_TITULAR_ENABLED=true
APPONO_ROTINA_INTELLIGENCE_ENABLED=false
APPONO_ROTINA_INTELLIGENCE_INTERNAL_ALLOWLIST=
APPONO_ROTINA_INTELLIGENCE_ROLLOUT_PERCENT=0
APPONO_ROTINA_INTELLIGENCE_ROLLOUT_SALT=troque-por-um-sal-estavel
APPONO_ROTINA_INTELLIGENCE_MIN_CONFIDENCE=0.25
APPONO_ROTINA_INTELLIGENCE_KILL_SWITCH=false
# Use somente durante a execução manual do seed em desenvolvimento/homologação.
APPONO_DEMO_SEED=
APPONO_DEMO_PASSWORD=
APPONO_DEMO_TARGET_HOST=
RESEND_API_KEY=re_sua-chave-do-resend
RESEND_FROM_EMAIL=Appono <notificacoes@seu-dominio.com>
APPONO_CRON_SECRET=segredo-longo-exclusivo-para-o-cron
