PORT=3001
NODE_ENV=production

# Frontend na Vercel (ajuste para seu dominio)
FRONTEND_ORIGIN=https://appono.vercel.app
FRONTEND_PUBLIC_URL=https://appono.vercel.app

# Backend na Oracle Cloud (ajuste para o IP publico da VM)
BACKEND_PUBLIC_URL=https://SEU-IP-OU-DOMINIO:3001

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-chave-publica
SUPABASE_SECRET_KEY=sua-chave-secreta
SUPABASE_ALLOW_INSECURE_TLS=false

# Administracao
APPONO_ADMIN_EMAILS=admin@gmail.com

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=seu-token
MERCADO_PAGO_TEST_ACCESS_TOKEN=seu-token-teste
MERCADO_PAGO_APP_ID=seu-app-id
MERCADO_PAGO_CLIENT_SECRET=seu-client-secret
MERCADO_PAGO_REDIRECT_URI=https://SEU-IP-OU-DOMINIO:3001/api/marketplace/mercado-pago/callback
MERCADO_PAGO_MARKETPLACE_FEE_PERCENTUAL=13
MERCADO_PAGO_MODO_REPASSE=SIMULADO
MERCADO_PAGO_PERMITIR_PRODUCAO=false

# RAG — Base de Conhecimento + Suporte a Recomendacoes
APPONO_RAG_ENABLED=true
APPONO_RAG_INTELLIGENCE_SUPPORT_ENABLED=true
APPONO_RAG_INGESTION_ENABLED=true
APPONO_RAG_VECTOR_SEARCH_ENABLED=true
APPONO_RAG_HYBRID_SEARCH_ENABLED=true
APPONO_RAG_LLM_ENABLED=true
APPONO_RAG_LLM_PROVIDER=ollama
APPONO_RAG_LLM_BASE_URL=http://ollama:11434
APPONO_RAG_LLM_MODEL=gemma3:4b
APPONO_RAG_LLM_TIMEOUT_MS=30000
APPONO_RAG_LLM_MAX_OUTPUT_TOKENS=500
APPONO_RAG_LLM_TEMPERATURE=0
APPONO_RAG_ALLOWED_ROLES=admin,restaurante,cliente
APPONO_RAG_MODEL_ID=Xenova/paraphrase-multilingual-MiniLM-L12-v2
APPONO_RAG_MODEL_REVISION=2c4055b12046f11709e9df2c122e59ffbdc2f900
APPONO_RAG_TOP_K=10
APPONO_RAG_MIN_SCORE=0.45
APPONO_RAG_MAX_CONTEXT_TOKENS=4000
APPONO_RAG_MAX_EMBEDDING_BATCH=16
