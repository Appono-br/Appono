[
  {"name":"cabecalho-cliente","route":"/cliente/configuracoes","widths":[320,360,390],"detail":"[...document.querySelector('header').querySelectorAll('a,button,img')].filter(e=>e.getBoundingClientRect().width).map(e=>({tag:e.tagName,label:e.getAttribute('aria-label')||e.alt||e.textContent,x:Math.round(e.getBoundingClientRect().x),w:Math.round(e.getBoundingClientRect().width)}))"},
  {"name":"rotina-enderecos","route":"/cliente/rotina/configurar","widths":[320,360,390,768,1024],"script":"[...document.querySelectorAll('h2')].find(e=>e.textContent==='Meus endereços').closest('section').scrollIntoView({block:'start',behavior:'instant'})"},
